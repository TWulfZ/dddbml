{
  "name": "dddbml",
  "displayName": "dddbml — DBML Diagram with Git-friendly Layout",
  "description": "Interactive DBML diagram renderer for VSCode with per-table position persistence, TableGroup collapse for DDD contexts, and viewport culling for large schemas (5000+ tables).",
  "version": "0.2.3",
  "publisher": "TWulfZ",
  "icon": "docs/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "dbml",
    "diagram",
    "erd",
    "database",
    "schema",
    "ddd"
  ],
  "main": "./dist/extension/extension/extension.js",
  "packageManager": "pnpm@11.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TWulfZ/dddbml"
  },
  "homepage": "https://github.com/TWulfZ/dddbml#readme",
  "bugs": {
    "url": "https://github.com/TWulfZ/dddbml/issues"
  },
  "contributes": {
    "commands": [
      {
        "command": "dddbml.openDiagram",
        "title": "dddbml: Open Diagram",
        "category": "dddbml",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "dddbml.resetLayout",
        "title": "dddbml: Reset Layout (re-run auto-layout)",
        "category": "dddbml"
      },
      {
        "command": "dddbml.pruneOrphans",
        "title": "dddbml: Prune orphan layout entries",
        "category": "dddbml"
      },
      {
        "command": "dddbml.exportSchema",
        "title": "dddbml: Export Schema…",
        "category": "dddbml"
      },
      {
        "command": "dddbml.autoArrange",
        "title": "dddbml: Auto-arrange Diagram…",
        "category": "dddbml"
      },
      {
        "command": "dddbml.zoomIn",
        "title": "dddbml: Zoom In",
        "category": "dddbml"
      },
      {
        "command": "dddbml.zoomOut",
        "title": "dddbml: Zoom Out",
        "category": "dddbml"
      },
      {
        "command": "dddbml.resetView",
        "title": "dddbml: Reset View",
        "category": "dddbml"
      },
      {
        "command": "dddbml.fitToContent",
        "title": "dddbml: Fit to Content",
        "category": "dddbml"
      }
    ],
    "keybindings": [
      {
        "command": "dddbml.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'dddbml.diagram'"
      },
      {
        "command": "dddbml.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeWebviewPanelId == 'dddbml.diagram'"
      },
      {
        "command": "dddbml.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'dddbml.diagram'"
      },
      {
        "command": "dddbml.resetView",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeWebviewPanelId == 'dddbml.diagram'"
      },
      {
        "command": "dddbml.fitToContent",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'dddbml.diagram'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .dbml",
          "command": "dddbml.openDiagram",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .dbml",
          "command": "dddbml.openDiagram",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "dbml",
        "extensions": [
          ".dbml"
        ],
        "aliases": [
          "DBML",
          "dbml"
        ]
      }
    ],
    "configuration": {
      "title": "dddbml",
      "properties": {
        "dddbml.zoomStep": {
          "type": "number",
          "default": 1.2,
          "minimum": 1.01,
          "maximum": 4,
          "description": "Multiplicative zoom factor applied per zoom-in / zoom-out click or keyboard shortcut."
        },
        "dddbml.zoomMin": {
          "type": "number",
          "default": 0.08,
          "minimum": 0.01,
          "maximum": 1,
          "description": "Minimum allowed zoom level (1 = 100%)."
        },
        "dddbml.zoomMax": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum allowed zoom level (1 = 100%)."
        },
        "dddbml.lod.mediumThreshold": {
          "type": "number",
          "default": 0.6,
          "minimum": 0.05,
          "maximum": 1,
          "description": "Below this zoom level, tables render in header-only LOD (name only, no columns)."
        },
        "dddbml.lod.lowThreshold": {
          "type": "number",
          "default": 0.3,
          "minimum": 0.01,
          "maximum": 1,
          "description": "Below this zoom level, tables render as colored rectangles (no text). Must be lower than mediumThreshold."
        },
        "dddbml.ui.density": {
          "type": "string",
          "default": "cozy",
          "enum": [
            "compact",
            "cozy",
            "comfortable"
          ],
          "enumDescriptions": [
            "Tight rows and narrow tables. Best for diagrams with 200+ tables.",
            "Default density. Balanced for typical DDD-sized diagrams.",
            "Roomy rows and wide tables. Best for small focused views."
          ],
          "description": "Visual density of tables and rows. Controls table width, row height, padding, and font size."
        },
        "dddbml.ui.snapToGrid": {
          "type": "boolean",
          "default": false,
          "description": "Magnet mode: snap table positions and edge bend vertices to the grid, and show a dotted grid background."
        },
        "dddbml.ui.gridSize": {
          "type": "number",
          "default": 16,
          "minimum": 2,
          "maximum": 128,
          "description": "World-unit spacing of the snap grid used when magnet mode (ui.snapToGrid) is on."
        },
        "dddbml.export.defaultFormat": {
          "type": "string",
          "default": "typeorm",
          "description": "Format pre-selected in the Export modal. Must match a registered exporter id."
        },
        "dddbml.export.typeorm.dialect": {
          "type": "string",
          "default": "postgres",
          "enum": [
            "postgres"
          ],
          "description": "SQL dialect that drives DBML→TypeScript type mapping for the TypeORM exporter."
        },
        "dddbml.export.typeorm.singularize": {
          "type": "boolean",
          "default": true,
          "description": "Singularize class names using an English heuristic (e.g. order_items → OrderItem)."
        },
        "dddbml.export.typeorm.includeImports": {
          "type": "boolean",
          "default": true,
          "description": "Emit the typeorm import line at the top of the generated file."
        },
        "dddbml.export.typeorm.emitNullableExplicit": {
          "type": "boolean",
          "default": true,
          "description": "Always include `nullable: true/false` in @Column options for non-primary columns."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:dbml",
    "onCommand:dddbml.openDiagram",
    "onCommand:dddbml.exportSchema"
  ],
  "scripts": {
    "build:extension": "node -e \"require('fs').rmSync('dist/extension',{recursive:true,force:true})\" && esbuild src/extension/extension.ts --bundle --outfile=dist/extension/extension/extension.js --external:vscode --platform=node --format=cjs --minify --sourcemap",
    "build:webview": "vite build",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "watch:extension": "esbuild src/extension/extension.ts --bundle --outfile=dist/extension/extension/extension.js --external:vscode --platform=node --format=cjs --sourcemap --watch",
    "watch:webview": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:gen": "mkdir -p test/fixtures && node scripts/gen-fixtures.mjs small > test/fixtures/small.dbml && node scripts/gen-fixtures.mjs huge > test/fixtures/huge.dbml && node scripts/gen-fixtures.mjs merge 3 && node scripts/gen-fixtures.mjs merge 20",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@dbml/core": "^3.9.0",
    "@vscode/codicons": "^0.0.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "preact": "^10.22.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
